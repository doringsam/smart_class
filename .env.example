# [스마트 클래스] Firebase 설정 환경변수 템플릿
# 이 파일을 복사하여 같은 위치에 '.env.local' 파일을 생성하고,
# Firebase 콘솔(https://console.firebase.google.com)의 프로젝트 설정에서 복사한 실제 키 값을 입력해 주세요.

# 1. Firebase API 키
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# 2. 인증 도메인 (예: your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here

# 3. 프로젝트 ID (예: your-project-id)
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here

# 4. 스토리지 버킷 (예: your-project-id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here

# 5. 메시징 전송자 ID (숫자 형태)
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# 6. 앱 ID (예: 1:123456789:web:abcdef123456)
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
